{
  "name": "harmony-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @harmony-lab/frontend",
    "build": "npm run build --workspace @harmony-lab/frontend",
    "typecheck": "npm run typecheck --workspace @harmony-lab/frontend",
    "lint": "npm run lint --workspace @harmony-lab/frontend",
    "test": "npm run test --workspace @harmony-lab/frontend",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}

