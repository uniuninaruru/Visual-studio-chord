# Native development server. Keep APP_HOST on loopback unless you understand
# the network exposure. Smartphone access is provided by the frontend proxy.
APP_HOST=127.0.0.1
APP_PORT=8765
MTC_FRONTEND_HOST=127.0.0.1
MTC_FRONTEND_PORT=5173

# FastAPI accepts explicit loopback origins only.
MTC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generated automatically by the LAN/Docker launchers. Do not commit a real value.
MTC_SHARED_TOKEN=

# auto prefers the empirical harmony corpus model in MODEL_DIRECTORY, then
# safely falls back to the theory-only deterministic implementation.
# Use corpus to require that first attempt; mock-deterministic is for development.
MTC_INFERENCE_MODEL=auto

# Model storage has no application-level size limit. Relative paths are resolved
# from the repository root. The tracked aggregate corpus model lives here.
MODEL_DIRECTORY=./models

# HarmonyForge is an optional research-preview generator. The native/base lock
# remains torch-free; the CPU Docker image includes the optional runtime. A real
# model is enabled only when a trained, evaluated, checksum-valid manifest and
# SafeTensors checkpoint are mounted under:
#   ./models/harmonyforge-bimask-base-v1/
NEURAL_MODEL_CONFIG=./configs/models/harmonyforge-bimask-base-v1.yaml

# Disabled by default. A research-only checkpoint still has to pass manifest
# and checksum validation; enabling this flag does not make it production-ready.
MTC_ENABLE_RESEARCH_CHECKPOINT=0

# Development fixture only. Responses remain visibly marked mock=true,
# trained=false, and notEvaluated in the API and UI.
MTC_ENABLE_NEURAL_MOCK=0

LOG_LEVEL=INFO
MTC_PACKAGE_MANAGER=auto
# setup.sh/setup.ps1 install pinned PyTorch by default. auto selects MPS on
# Apple silicon, CUDA when a usable NVIDIA runtime is detected, otherwise CPU.
# none skips this install step without removing an already installed runtime;
# Browser/Theory fallback remains available.
MTC_ACCELERATION=auto
MTC_BACKEND_ENABLED=1
MTC_DIAGNOSTICS_TIMEOUT_SECONDS=1.5
