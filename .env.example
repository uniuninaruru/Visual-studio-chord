# Native development server. Keep APP_HOST on loopback unless you understand
# the network exposure. Smartphone access is provided by the frontend proxy.
APP_HOST=127.0.0.1
APP_PORT=8765
MTC_FRONTEND_HOST=127.0.0.1
MTC_FRONTEND_PORT=5173

# FastAPI accepts explicit loopback origins only.
MTC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generated automatically by the LAN/Docker launchers. Do not commit a real value.
MTC_SHARED_TOKEN=

# auto selects an available local runtime and safely falls back to the
# deterministic CPU implementation. mock-deterministic is for development.
MTC_INFERENCE_MODEL=auto

# Optional developer settings. Relative paths are resolved from the repository
# root. The built-in Phase 2 rankers do not require an external model file.
MODEL_DIRECTORY=./models
LOG_LEVEL=INFO
MTC_PACKAGE_MANAGER=auto
MTC_BACKEND_ENABLED=1
MTC_DIAGNOSTICS_TIMEOUT_SECONDS=1.5
