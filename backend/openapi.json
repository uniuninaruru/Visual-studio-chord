          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An internal server error occurred."
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/models": {
